generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MinistryKey {
  HEALTH
  EDUCATION
  ECONOMY
  DEFENSE
  SECURITY
  JUSTICE
  AGRICULTURE
  SOCIAL_DEVELOPMENT
  FOREIGN_AFFAIRS
  ENVIRONMENT
  LABOR
  INFRASTRUCTURE
  CULTURE
  SCIENCE_TECH
}

enum OfficialRole {
  MINISTER
  JUDGE
  PROSECUTOR
  GENERAL
  CHIEF_OF_INTELLIGENCE
  COMPTROLLER
  OMBUDSMAN
  CENTRAL_BANK_PRESIDENT
  POLITICAL_LEADER
  MINISTRY_DIRECTOR
}

enum OfficialStatus {
  ACTIVE
  INVESTIGATED
  INDICTED
  CONVICTED
  DISMISSED
  CANDIDATE
}

enum Chamber {
  LOWER
  UPPER
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CaseType {
  CORRUPTION
  CRIMINAL
  CIVIL
}

enum CasePhase {
  INVESTIGATION
  TRIAL
  SENTENCING
  APPEAL
  CLOSED
}

enum OrganismType {
  COMPTROLLER
  ANTICORRUPTION_PROSECUTION
  INTELLIGENCE
  OMBUDSMAN
  CONSTITUTIONAL_COURT
  CENTRAL_BANK
  TAX_AGENCY
  ELECTORAL_COUNCIL
}

enum SocialClassKey {
  EXTREME_POVERTY
  POVERTY
  MIDDLE
  ELITE
}

enum MediaType {
  TV
  NEWSPAPER
  DIGITAL
}

enum MediaStatus {
  ACTIVE
  CENSORED
  CLOSED
}

enum EventType {
  EPIDEMIC
  SCANDAL
  PROTEST
  CRIME_SURGE
  COUP_ATTEMPT
  DISASTER
  DISCOVERY
  ECONOMIC_CRISIS
  LEAK
  OTHER
  DISEASE_OUTBREAK
  HOSPITAL_COLLAPSE
  MEDICATION_SHORTAGE
  MALPRACTICE_SCANDAL
  MEDICAL_BREAKTHROUGH
}

enum TradeGoodCategory {
  MEDICAMENTS_GENERIC
  MEDICAMENTS_BRAND
}

enum TradeFlowDirection {
  IMPORT
  EXPORT
}

enum GameStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum InfrastructureType {
  ENERGY
  WATER
  ROADS
  RAIL
  INTERNET
  HOUSING
}

enum LRDecisionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LRDecisionType {
  OBRA_DE_PRUEBA
  HOSPITAL_CONSTRUCTION
  MEDICAL_RESEARCH
}

enum ProgramType {
  VACCINATION_CAMPAIGN
  PREVENTION_EDUCATION
  MENTAL_HEALTH_PROGRAM
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
  games        Game[]
}

model Game {
  id            String    @id @default(uuid())
  userId        String
  countryName   String
  currentYear   Int       @default(1)
  currentMonth  Int       @default(1)
  status        GameStatus @default(ACTIVE)
  seed          String
  preset        String
  difficulty    String    @default("normal")
  treasury      Float     @default(1000000)
  population    Int       @default(10000000)
  consecutiveLowApprovalMonths Int @default(0)
  healthEfficiencyStreak      Int @default(0)
  consecutiveSaturationMonths Json?
  sanctionsMultiplier Float  @default(1.0)
  // Versión de las migraciones de datos de siembra ya aplicadas (lib/seed-integrity.ts).
  // Las partidas nuevas nacen con SEED_VERSION; las anteriores a una migración tienen menos.
  seedVersion   Int       @default(0)
  createdAt     DateTime  @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots     MonthSnapshot[]
  ministries    Ministry[]
  officials     Official[]
  parties       Party[]
  senators      Senator[]
  lawProposals  LawProposal[]
  activeLaws    ActiveLaw[]
  judicialCases JudicialCase[]
  organisms     Organism[]
  socialClasses SocialClass[]
  regimeMetrics RegimeMetrics[]
  media         Media[]
  events         Event[]
  mediaCoverages MediaCoverage[]
  countries      Country[]
  treaties      Treaty[]
  longRunningDecisions LongRunningDecision[]
  resourceStocks ResourceStock[]
  diseasePrevalences DiseasePrevalence[]
  diseases      Disease[]
  infrastructures Infrastructure[]
  regions       Region[]
  programs      MinistryProgram[]
  tradeGoods    TradeGood[]
  tradeFlows    TradeFlow[]

  @@index([userId])
  @@index([status])
}

model MonthSnapshot {
  id            String   @id @default(uuid())
  gameId        String
  year          Int
  month         Int
  treasury      Float
  gdp           Float
  population    Int
  approval      Float
  corruption    Float
  povertyRate       Float
  unemploymentRate  Float
  sickRate          Float
  crimeRate         Float
  foodSecurity      Float
  educationLevel    Float
  inflation         Float
  gini              Float
  regimeType        String
  regimeMetrics     Json
  aiEventNarratives     Json?
  aiCoverageNarratives  Json?
  lifeExpectancy    Float      @default(68)
  activeLrdCount    Int        @default(0)
  lrdMonthlyCost    Float      @default(0)
  lrdCompletedThisMonth Int   @default(0)
  lrdCancelledThisMonth Int   @default(0)
  activeProgramsCount  Int   @default(0)
  programMonthlyCost   Float @default(0)
  diseasePrevalences   Json?
  tradeBalance      Float      @default(0)
  totalImports      Float      @default(0)
  totalExports      Float      @default(0)
  createdAt     DateTime @default(now())

  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, year, month])
  @@index([gameId])
}

model Ministry {
  id               String      @id @default(uuid())
  gameId           String
  key              MinistryKey
  budgetPercent    Float       @default(12.5)
  efficiency       Float       @default(50)
  internalCorruption Float     @default(10)
  subDecisions     Json        @default("{}")
  ministerOfficialId String?
  producedResources Json        @default("{}")
  consumedResources Json        @default("{}")
  healthBudgetSplit Json        @default("{ \"primary\": 50, \"secondary\": 30, \"tertiary\": 20 }")

  game             Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  minister         Official?      @relation("MinisterMinistry", fields: [ministerOfficialId], references: [id])
  decisions        MinistryDecision[]

  @@unique([gameId, key])
  @@index([gameId])
}

model MinistryDecision {
  id           String   @id @default(uuid())
  ministryId   String
  key          String
  value        Float
  activatedAt  DateTime @default(now())

  ministry     Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@index([ministryId])
}

model Official {
  id           String         @id @default(uuid())
  gameId       String
  name         String
  role         OfficialRole
  specialty    String?
  ministryId   String?
  partyId      String?
  loyalty      Float          @default(50)
  ambition     Float          @default(30)
  wealth       Float          @default(10000)
  ideology     Json           @default("{\"economic\":0,\"social\":0,\"authority\":0}")
  corruption   Float          @default(10)
  skill        Float          @default(50)
  reputation   Float          @default(50)
  status       OfficialStatus @default(ACTIVE)
  appointedAt  DateTime       @default(now())

  game             Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ministryManaged  Ministry[]       @relation("MinisterMinistry")
  party            Party?           @relation("PartyMembers", fields: [partyId], references: [id])
  partyLed         Party[]          @relation("PartyLeader")
  organismHeaded   Organism[]
  casesAsDefendant JudicialCase[]   @relation("Defendant")
  casesAsProsecutor JudicialCase[]  @relation("Prosecutor")
  casesAsJudge     JudicialCase[]   @relation("Judge")

  @@index([gameId])
  @@index([role])
  @@index([status])
}

model Party {
  id               String    @id @default(uuid())
  gameId           String
  name             String
  ideology         Json      @default("{\"economic\":0,\"social\":0,\"authority\":0}")
  leaderOfficialId String?
  popularity       Float     @default(20)
  seatsLower       Int       @default(0)
  seatsUpper       Int       @default(0)

  game             Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  leader           Official?  @relation("PartyLeader", fields: [leaderOfficialId], references: [id])
  senators         Senator[]
  officials        Official[] @relation("PartyMembers")

  @@index([gameId])
}

model Senator {
  id              String  @id @default(uuid())
  gameId          String
  partyId         String
  name            String
  personalIdeology Json   @default("{\"economic\":0,\"social\":0,\"authority\":0}")
  chamber         Chamber
  loyalty         Float   @default(50)

  game            Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  party           Party   @relation(fields: [partyId], references: [id])

  @@index([gameId])
  @@index([partyId])
}

model LawCatalog {
  id            String  @id @default(uuid())
  key           String  @unique
  name          String
  description   String
  effectsJson   Json
  idealIdeology Json
  cost          Float   @default(0)
  isAvailable   Boolean @default(true)
}

model LawProposal {
  id           String         @id @default(uuid())
  gameId       String
  lawKey       String
  proposedAt   DateTime       @default(now())
  status       ProposalStatus @default(PENDING)
  votesFor     Int            @default(0)
  votesAgainst Int            @default(0)
  votesAbstain Int            @default(0)
  resolvedAt   DateTime?

  game         Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([status])
}

model ActiveLaw {
  id          String    @id @default(uuid())
  gameId      String
  lawKey       String
  activatedAt DateTime  @default(now())
  repealedAt  DateTime?

  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model JudicialCase {
  id                  String    @id @default(uuid())
  gameId              String
  defendantOfficialId String
  caseType            CaseType
  description         String
  openedAt            DateTime  @default(now())
  currentPhase        CasePhase @default(INVESTIGATION)
  monthsInPhase       Int       @default(0)
  evidenceStrength    Float     @default(30)
  prosecutorId        String?
  judgeId             String?
  verdict             String?
  sentenceMonths      Int?
  closedByBugfix      Boolean   @default(false)

  game                Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  defendant           Official   @relation("Defendant", fields: [defendantOfficialId], references: [id])
  prosecutor          Official?  @relation("Prosecutor", fields: [prosecutorId], references: [id])
  judge               Official?  @relation("Judge", fields: [judgeId], references: [id])
  investigations      Investigation[]

  @@index([gameId])
  @@index([currentPhase])
}

model Investigation {
  id          String  @id @default(uuid())
  caseId      String
  openedBy    String
  monthsActive Int    @default(0)
  progress    Float   @default(0)

  judicialCase JudicialCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Organism {
  id              String       @id @default(uuid())
  gameId          String
  type            OrganismType
  name            String
  monthlyBudget   Float        @default(0)
  staff           Int          @default(0)
  effectiveness   Float        @default(20)
  autonomyLevel   Float        @default(50)
  headOfficialId  String?
  createdAt       DateTime     @default(now())
  dissolvedAt     DateTime?

  game            Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  headOfficial    Official?    @relation(fields: [headOfficialId], references: [id])

  @@index([gameId])
  @@index([type])
}

model SocialClass {
  id               String        @id @default(uuid())
  gameId           String
  key              SocialClassKey
  populationPercent Float        @default(25)
  averageIncome    Float         @default(0)
  approval         Float         @default(50)
  demands          Json          @default("[]")
  educationLevel   Float         @default(30)
  healthAccess     Float         @default(50)

  game             Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, key])
  @@index([gameId])
}

model RegimeMetrics {
  id                    String   @id @default(uuid())
  gameId                String
  powerConcentration    Float    @default(30)
  pressFreedom          Float    @default(70)
  judicialIndependence  Float    @default(60)
  politicalPluralism    Float    @default(70)
  civilLiberties        Float    @default(70)
  transparency          Float    @default(50)
  militarySubordination Float    @default(60)
  updatedAt             DateTime @updatedAt

  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Media {
  id                  String      @id @default(uuid())
  gameId              String
  name                String
  type                MediaType
  ideologicalAffinity Json        @default("{\"economic\":0,\"social\":0,\"authority\":0}")
  reach               Float       @default(50)
  credibility         Float       @default(60)
  governmentAffinity  Float       @default(0)
  status              MediaStatus @default(ACTIVE)

  game                Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  coverages           MediaCoverage[]

  @@index([gameId])
}

model MediaCoverage {
  id               String   @id @default(uuid())
  mediaId          String
  gameId           String
  year             Int
  month            Int
  eventId          String?
  headline         String
  sentiment        Float    @default(0)
  impactOnApproval Json     @default("{}")

  media            Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([gameId])
  @@index([gameId, year, month])
}

model Event {
  id             String    @id @default(uuid())
  gameId         String
  type           EventType
  severity       Float     @default(50)
  year           Int
  month          Int
  description    String
  effectsApplied Json      @default("{}")
  resolvedAt     DateTime?

  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, year, month])
}

model LongRunningDecision {
  id               String          @id @default(uuid())
  gameId           String
  type             LRDecisionType
  name             String
  monthsRemaining  Int
  totalMonths      Int
  monthlyCost      Float           @default(0)
  parameters       Json            @default("{}")
  status           LRDecisionStatus @default(IN_PROGRESS)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?
  progressLog      Json            @default("[]")
  effectOnCompletion Json          @default("{}")

  game             Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, status])
}

model ResourceStock {
  id           String   @id @default(uuid())
  gameId       String
  resourceType String
  quantity     Float    @default(0)
  updatedAt    DateTime @updatedAt

  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, resourceType])
  @@index([gameId])
}

// ─── Fase 2: solo esquema, lógica como stub ──────────────────────────────────

model Country {
  id             String @id @default(uuid())
  gameId         String
  name           String
  relationStatus String @default("neutral")
  militaryPower  Float  @default(50)
  economicPower  Float  @default(50)
  isNeighbor     Boolean @default(false)

  game           Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Treaty {
  id        String   @id @default(uuid())
  gameId    String
  countryId String
  type      String
  signedAt  DateTime @default(now())

  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([countryId])
}

model Disease {
  id                   String  @id @default(uuid())
  gameId               String
  name                 String
  category             String  @default("TRANSMISSIBLE")
  contagionRate        Float   @default(0.1)
  mortalityRate        Float   @default(0.01)
  prevalence           Float   @default(0)
  prevalenceBase       Float   @default(5)
  hasVaccine           Boolean @default(false)
  preventionSensitivity Float  @default(0.5)
  monthlyCostPerPatient Float  @default(500)
  classAffinity        Json    @default("{ \"EXTREME_POVERTY\": 1.5, \"POVERTY\": 1.2, \"MIDDLE\": 0.8, \"ELITE\": 0.5 }")

  game          Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  prevalences   DiseasePrevalence[]

  @@index([gameId])
  @@index([category])
}

model DiseasePrevalence {
  id            String   @id @default(uuid())
  gameId        String
  diseaseId     String
  currentPrevalence Float @default(0)
  regionId      String?
  updatedAt     DateTime @updatedAt

  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  disease       Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@unique([gameId, diseaseId])
  @@index([gameId])
  @@index([diseaseId])
}

model Infrastructure {
  id              String             @id @default(uuid())
  gameId          String
  type            InfrastructureType
  coveragePercent Float              @default(50)
  maintenanceCost Float              @default(0)
  condition       Float              @default(50)

  game            Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Region {
  id                  String @id @default(uuid())
  gameId              String
  name                String
  type                String @default("URBAN")
  populationPercent   Float  @default(25)
  povertyRate         Float  @default(30)
  infrastructureLevel Float  @default(50)
  accessModifier      Float  @default(0.5)
  povertyModifier     Float  @default(1.0)
  healthCoverage      Json   @default("{\"primary\":{\"facilities\":5,\"beds\":200,\"operationalCost\":500000},\"secondary\":{\"facilities\":2,\"beds\":100,\"operationalCost\":300000},\"tertiary\":{\"facilities\":1,\"beds\":50,\"operationalCost\":700000}}")

  game                Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// ─── Programas operativos de ministerios (Salud-3A Capa D) ───────────────────
// Programas lanzables por el Ministro (sin aprobacion del Senado).
// Costo mensual descontado del tesoro automaticamente.
// Tipos 1-3 son persistentes (on/off); tipos 4-5 usan el sistema LRD.

model MinistryProgram {
  id             String          @id @default(uuid())
  gameId          String
  type           ProgramType
  parameters     Json            @default("{}")
  monthlyCost    Float           @default(0)
  status          ProgramStatus  @default(ACTIVE)
  startedAt      DateTime        @default(now())
  deactivatedAt  DateTime?

  game           Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, status])
  @@index([type])
}

// ─── Comercio Exterior (Salud-3B-i) ──────────────────────────────────────────
// Catálogo de bienes comerciables y flujos de importación/exportación.
// Genérico: reutilizable para Defensa-3, Economía-3, etc.

model TradeGood {
  id              String            @id @default(uuid())
  gameId          String
  key             String
  category        TradeGoodCategory
  name            String
  description     String?
  baseCostPerUnit Float
  unitDescription String
  demandPerCapita Float

  game            Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  flows           TradeFlow[]

  @@unique([gameId, key])
  @@index([gameId])
}

model TradeFlow {
  id                   String             @id @default(uuid())
  gameId               String
  tradeGoodId          String
  direction            TradeFlowDirection
  monthlyVolume        Float
  targetVolume         Float
  unitCost             Float
  sanctionsMultiplier  Float              @default(1.0)
  monthlyCost          Float
  isActive             Boolean            @default(true)

  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tradeGood            TradeGood          @relation(fields: [tradeGoodId], references: [id])

  @@index([gameId])
  @@index([gameId, direction])
}
