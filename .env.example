# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Cadena de conexión. Local con Docker (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/juego_vida"
# Postgres en un VPS (la contraseña va codificada: @ → %40, : → %3A, / → %2F, # → %23, ? → %3F, % → %25):
# DATABASE_URL="postgresql://simulador:CLAVE@mi-vps.example.com:5432/simulador"

# TLS del runtime (la app). Opcional; sin definir se respeta ?sslmode= de la URL y, sin nada, no se cifra.
#   disable  → sin cifrar (local)
#   require  → cifra y acepta un certificado autofirmado (VPS típico)
#   verify   → cifra y verifica el certificado (usa DATABASE_SSL_CA si es de una CA propia)
# DATABASE_SSL="require"
# DATABASE_SSL_CA="/ruta/a/ca.pem"     # PEM o ruta; solo con DATABASE_SSL=verify

# Pool de conexiones (valores por defecto)
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000

# Transacciones largas (guardar un turno). Prisma corta a los 5 s por defecto; aquí 60 s.
# Contra un Postgres remoto cada sentencia cuesta una ida y vuelta de red.
# DATABASE_TRANSACTION_TIMEOUT_MS=60000
# DATABASE_TRANSACTION_MAX_WAIT_MS=10000

# Nota: la CLI de Prisma (migrate, db seed) NO lee DATABASE_SSL; negocia TLS desde la URL. Si falla por un
# certificado autofirmado, añade a la URL: ?sslmode=require&sslaccept=accept_invalid_certs

# ─── Autenticación ────────────────────────────────────────────────────────────
# Cadena larga y aleatoria (openssl rand -base64 32). Basta con AUTH_SECRET; NEXTAUTH_SECRET
# (nombre antiguo) también se acepta. Sin ninguna, las páginas protegidas fallan con "MissingSecret".
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Producción (`next start`, detrás de un proxy o en tu VPS): Auth.js exige un host de confianza o el inicio
# de sesión falla con "UntrustedHost". Define una de las dos (no hace falta en `npm run dev`):
# AUTH_TRUST_HOST=true
# AUTH_URL="https://tu-dominio.com"

# ─── IA opcional ──────────────────────────────────────────────────────────────
# AI_PROVIDER=none            # none | openai | anthropic | ollama
# AI_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
